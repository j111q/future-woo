{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"lib": [ "DOM", "ESNext" ],
		"baseUrl": ".",
		"paths": {
			"~/*": [ "src/*" ]
		}
	},
	"include": [ "src/campaigns/**/*", "src/analytics/**/*" ],
	"exclude": [ "node_modules", "assets", "build" ]
}
